# Logs técnicos do rclone (giram a cada 7 dias; podem conter caminhos de clientes)
logs/
*.log
*.tmp

# Nunca versionar credenciais do rclone
rclone.conf

# Configurações locais da IDE
.codebuddy/

# Runtime da triagem de campo (log e dados de visitas do usuário)
triagem-log.txt
visitas.json

# runs/ é PERMANENTE no disco (nenhuma rotina de limpeza apaga), mas NÃO versionado:
# manifestos reais podem conter nomes de produtores e coordenadas GPS de clientes.
runs/*
!runs/.gitkeep